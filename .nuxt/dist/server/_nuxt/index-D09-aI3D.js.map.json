,QAAQ,EAAE,MAAM,IAAG,OAAG,CAAA;AAAA,kBAAA;AAAA;;;;AAE9HL,mBAAAE,mBAAAH,MAAAI,QAAA,GAAA,EAAA,QAAO,QAAI;AAAA,cAAY,cAAX,CAA+J,EAAA,QAAAH,QAAAC,UAAAG,cAAA;;;oBAA9H,OAAO,KAAK;AAAA,oBAAS,UAAU,KAAK,WAAM,QAAA,YAAyB,KAAK,WAAM,QAAA,SAAA;AAAA,kBAAA;;;oBAApFE,YAAyHP,MAAAQ,QAAA,GAAA;AAAA,sBAAnH,OAAO,KAAK;AAAA,sBAAS,UAAU,KAAK,WAAM,QAAA,YAAyB,KAAK,WAAM,QAAA,SAAA;AAAA,oBAAA;;;;;;AAC3HP,mBAAAE,mBAAAH,MAAAI,QAAA,GAAA,EAAA,QAAO,MAAE;AAAA,cAAY,cAAX,CAA2F,EAAA,QAAAH,QAAAC,UAAAG,cAAA;;;oBAAxD,OAAM;AAAA,oBAAK,MAAA;AAAA,oBAAM,SAAK,CAAA,WAAE,SAAS,KAAK,EAAE;AAAA,kBAAA;;;oBAAhDE,YAAqDP,MAAAS,QAAA,GAAA;AAAA,sBAA7C,OAAM;AAAA,sBAAK,MAAA;AAAA,sBAAM,SAAK,CAAA,WAAE,SAAS,KAAK,EAAE;AAAA,oBAAA;;;;;;;;cAX7FF,YAAmCP,MAAAI,QAAA,GAAA;AAAA,gBAA3B,OAAM;AAAA,gBAAK,QAAO;AAAA,cAAA;cAC1BG,YAAmCP,MAAAI,QAAA,GAAA;AAAA,gBAA3B,OAAM;AAAA,gBAAO,QAAO;AAAA,cAAA;cAC5BG,YAAmCP,MAAAI,QAAA,GAAA;AAAA,gBAA3B,OAAM;AAAA,gBAAO,QAAO;AAAA,cAAA;cAC5BG,YAAmCP,MAAAI,QAAA,GAAA;AAAA,gBAA3B,OAAM;AAAA,gBAAO,QAAO;AAAA,cAAA;cAC5BG,YAESP,MAAAI,QAAA,GAAA,EAFD,QAAO,SAAK;AAAA,gBACP,MAAIM,QAAY,CAAmE,EAA3E,WAAI;AAAA,kDAAO,KAAK,MAAM,QAAQ,SAAc,KAAK,iBAAiB,MAAM,IAAG,QAAGJ,gBAAG,KAAK,MAAM,MAAM,IAAG,OAAG,CAAA;AAAA,gBAAA;;;cAE7HC,YAESP,MAAAI,QAAA,GAAA,EAFD,QAAO,QAAI;AAAA,gBACN,MAAIM,QAAY,CAA8B,EAAtC,WAAI;AAAA,kDAAO,KAAK,aAAa,MAAM,IAAG,SAAIJ,gBAAG,KAAK,aAAa,OAAM,CAAE,SAAS,CAAM,KAAK,QAAQ,EAAE,MAAM,IAAG,OAAG,CAAA;AAAA,gBAAA;;;cAEtIC,YAA4LP,MAAAI,QAAA,GAAA,EAApL,QAAO,QAAI;AAAA,gBAAY,MAAIM,QAAY,CAAyH,EAAjI,WAAI;AAAA,kBAAIH,YAAyHP,MAAAQ,QAAA,GAAA;AAAA,oBAAnH,OAAO,KAAK;AAAA,oBAAS,UAAU,KAAK,WAAM,QAAA,YAAyB,KAAK,WAAM,QAAA,SAAA;AAAA,kBAAA;;;;cACnID,YAAsHP,MAAAI,QAAA,GAAA,EAA9G,QAAO,MAAE;AAAA,gBAAY,MAAIM,QAAY,CAAqD,EAA7D,WAAI;AAAA,kBAAIH,YAAqDP,MAAAS,QAAA,GAAA;AAAA,oBAA7C,OAAM;AAAA,oBAAK,MAAA;AAAA,oBAAM,SAAK,CAAA,WAAE,SAAS,KAAK,EAAE;AAAA,kBAAA;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_push","_parent","_ssrRenderComponent","Column","_scopeId","_toDisplayString","_createVNode","Tag","Button","_withCtx"],"sources":["../../../../services/api.ts","../../../../pages/index.vue"],"sourcesContent":["import { ofetch } from 'ofetch'\nimport type { EquipmentNode } from '../types/domain'\n\nconst client = ofetch.create({ baseURL: process.env.NUXT_PUBLIC_API_BASE_URL || '/api', timeout: 5000 })\n\nexport async function loadEquipmentSnapshot(fallback: EquipmentNode[]): Promise<EquipmentNode[]> {\n  if (!process.env.NUXT_PUBLIC_API_BASE_URL) return fallback\n  try { return await client<EquipmentNode[]>('/acceptance/equipment') } catch { return fallback }\n}\n\nexport async function validateEvidencePackage(payload: unknown) {\n  if (!process.env.NUXT_PUBLIC_API_BASE_URL) return { accepted: true, packageId: `LOCAL-${Date.now()}` }\n  return client('/acceptance/validate-package', { method: 'POST', body: payload })\n}\n","<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport { useQuery } from '@tanstack/vue-query'\nimport Button from 'primevue/button'\nimport DataTable from 'primevue/datatable'\nimport Column from 'primevue/column'\nimport Tag from 'primevue/tag'\nimport InputText from 'primevue/inputtext'\nimport { useAcceptanceStore } from '../stores/acceptance'\nimport { loadEquipmentSnapshot } from '../services/api'\n\nconst store = useAcceptanceStore()\nconst { isFetching } = useQuery({ queryKey: ['equipment-snapshot'], queryFn: () => loadEquipmentSnapshot(store.equipment), staleTime: 60000 })\nconst rows = computed(() => store.equipment.filter((node) => {\n  const items = node.items.map((item) => `${item.id} ${item.standard} ${item.status}`).join(' ')\n  return !store.keyword || `${node.id} ${node.name} ${node.code} ${node.type} ${items}`.includes(store.keyword)\n}))\nconst navigate = (id: string) => navigateTo(`/equipment/${id}`)\n</script>\n\n<template>\n  <section class=\"page\">\n    <div class=\"metrics\">\n      <article><span>验收项</span><strong>{{ store.stats.total }}</strong><small>按设备树逐项检查</small></article>\n      <article><span>已合格</span><strong>{{ store.stats.passed }}</strong><small>测试条件与证据齐全</small></article>\n      <article><span>不合格或待复验</span><strong>{{ store.stats.failed }}</strong><small>不可直接签署</small></article>\n      <article><span>未闭环缺陷</span><strong>{{ store.stats.openDefects }}</strong><small>多方责任协同</small></article>\n    </div>\n    <div class=\"toolbar\">\n      <InputText v-model=\"store.keyword\" placeholder=\"搜索设备、编号、验收项或状态\" />\n      <span>{{ isFetching ? '正在同步' : '设备快照已加载' }}</span>\n      <Button label=\"恢复演示数据\" severity=\"secondary\" outlined @click=\"store.reset\" />\n    </div>\n    <DataTable :value=\"rows\" dataKey=\"id\" size=\"small\" stripedRows>\n      <Column field=\"id\" header=\"设备节点\" />\n      <Column field=\"name\" header=\"名称\" />\n      <Column field=\"type\" header=\"类型\" />\n      <Column field=\"code\" header=\"编码\" />\n      <Column header=\"验收项\">\n        <template #body=\"{ data }\">{{ data.items.filter((item: any) => item.status === '合格').length }} / {{ data.items.length }} 合格</template>\n      </Column>\n      <Column header=\"证书\">\n        <template #body=\"{ data }\">{{ data.certificates.length }}份 · {{ data.certificates.filter((item: any) => !item.verified).length }}份待核</template>\n      </Column>\n      <Column header=\"状态\"><template #body=\"{ data }\"><Tag :value=\"data.status\" :severity=\"data.status === '已验收' ? 'success' : data.status === '验收中' ? 'warn' : 'secondary'\" /></template></Column>\n      <Column header=\"\"><template #body=\"{ data }\"><Button label=\"打开\" text @click=\"navigate(data.id)\" /></template></Column>\n    </DataTable>\n  </section>\n</template>\n"],"version":3}